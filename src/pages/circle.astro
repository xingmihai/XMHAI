---
import { Icon } from "astro-icon/components";
import { circleConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/circle.css";

// 检查页面是否启用
if (!siteConfig.pages.circle) {
	return Astro.redirect("/404/");
}

const title = circleConfig.title || "圈子";
const description =
	circleConfig.description || "朋友们最近写下的东西，由订阅源自动汇总。";

// 运行时数据源：由独立仓库 circle-feed 定时抓取后发布
// 页面在浏览器里读取，因此更新文章数据无需重建本站
const dataUrls = circleConfig.dataUrls ?? [];
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-6">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:rss-feed-rounded" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <!-- 内容由脚本异步填充 -->
      <div id="circle-root" data-urls={dataUrls.join("|")}>
        <div class="flex flex-col items-center justify-center py-14 text-neutral-400 dark:text-neutral-500">
          <Icon name="material-symbols:rss-feed-rounded" class="text-4xl mb-3 animate-pulse" />
          <div class="text-sm">正在获取最新文章…</div>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script is:inline define:vars={{ dataUrls }}>
	(function () {
		var root = document.getElementById("circle-root");
		if (!root) return;

		function escapeHtml(text) {
			return String(text == null ? "" : text)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		function pad(n) {
			return String(n).padStart(2, "0");
		}

		// 文章日期：YYYY-MM-DD
		function formatDate(timestamp) {
			if (!timestamp) return "";
			var d = new Date(timestamp);
			if (isNaN(d.getTime())) return "";
			return (
				d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate())
			);
		}

		// 数据更新时间：YYYY-MM-DD HH:mm
		function formatUpdated(iso) {
			if (!iso) return "";
			var d = new Date(iso);
			if (isNaN(d.getTime())) return "";
			return (
				d.getFullYear() +
				"-" +
				pad(d.getMonth() + 1) +
				"-" +
				pad(d.getDate()) +
				" " +
				pad(d.getHours()) +
				":" +
				pad(d.getMinutes())
			);
		}

		function renderEmpty(text, hint) {
			root.innerHTML =
				'<div class="flex flex-col items-center justify-center py-14 text-neutral-400 dark:text-neutral-500">' +
				'<div class="text-4xl mb-3">📭</div>' +
				'<div class="text-sm">' +
				escapeHtml(text) +
				"</div>" +
				(hint
					? '<div class="text-xs mt-1.5 opacity-70">' + escapeHtml(hint) + "</div>"
					: "") +
				"</div>";
		}

		function render(data) {
			var items = (data && data.items) || [];
			var sources = (data && data.sources) || [];
			var failures = (data && data.failures) || [];
			var updated = formatUpdated(data && data.updatedAt);

			var html = "";

			// 订阅源概览
			if (sources.length > 0) {
				html += '<div class="flex flex-wrap items-center gap-2 mb-5">';
				html +=
					'<span class="text-sm text-neutral-500 dark:text-neutral-400">已订阅 ' +
					sources.length +
					" 个站点" +
					(updated ? " · 更新于 " + escapeHtml(updated) : "") +
					"</span>";
				sources.forEach(function (s) {
					html +=
						'<a href="' +
						escapeHtml(s.site) +
						'" target="_blank" rel="noopener noreferrer"' +
						' class="circle-source-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs transition-colors duration-200">';
					if (s.avatar) {
						html +=
							'<img src="' +
							escapeHtml(s.avatar) +
							'" alt="' +
							escapeHtml(s.name) +
							'" class="circle-source-avatar" />';
					}
					html += "<span>" + escapeHtml(s.name) + "</span>";
					if (s.ok === false) {
						html += '<span class="opacity-60" title="该站点未能抓到内容">·</span>';
					}
					html += "</a>";
				});
				html += "</div>";
			}

			// 文章列表
			if (items.length > 0) {
				html += '<div class="circle-list">';
				items.forEach(function (item) {
					var date = formatDate(item.timestamp);
					html +=
						'<a href="' +
						escapeHtml(item.link) +
						'" target="_blank" rel="noopener noreferrer"' +
						' class="circle-item group flex items-start gap-3 py-3.5 px-3 -mx-3 rounded-xl transition-all duration-200">';
					if (item.sourceAvatar) {
						html +=
							'<img src="' +
							escapeHtml(item.sourceAvatar) +
							'" alt="' +
							escapeHtml(item.sourceName) +
							'" class="circle-item-avatar" />';
					} else {
						html +=
							'<div class="circle-item-avatar circle-item-avatar--placeholder">📡</div>';
					}
					html += '<div class="grow min-w-0">';
					html +=
						'<div class="circle-item-title group-hover:text-(--primary) transition-colors duration-200 line-clamp-2">' +
						escapeHtml(item.title) +
						"</div>";
					html +=
						'<div class="flex items-center gap-2 mt-1 text-xs text-neutral-500 dark:text-neutral-400">';
					html +=
						'<span class="truncate max-w-[14rem]">' +
						escapeHtml(item.sourceName) +
						"</span>";
					if (date) {
						html +=
							'<span aria-hidden="true">·</span><time class="shrink-0">' +
							escapeHtml(date) +
							"</time>";
					}
					html += "</div></div>";
					html +=
						'<span class="shrink-0 text-base text-(--primary) opacity-0 group-hover:opacity-100 transition-opacity duration-200 mt-0.5">↗</span>';
					html += "</a>";
				});
				html += "</div>";
			} else {
				html +=
					'<div class="flex flex-col items-center justify-center py-14 text-neutral-400 dark:text-neutral-500">' +
					'<div class="text-sm">还没有抓到任何文章</div>' +
					'<div class="text-xs mt-1.5 opacity-70">可在数据源仓库里检查订阅源配置与抓取日志</div>' +
					"</div>";
			}

			// 抓取失败的站点
			if (failures.length > 0) {
				html += '<details class="circle-failures mt-6 text-xs">';
				html +=
					'<summary class="cursor-pointer text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition-colors duration-200">' +
					failures.length +
					" 个站点未能抓到内容</summary>";
				html += '<ul class="mt-2 space-y-1 pl-1">';
				failures.forEach(function (f) {
					html +=
						'<li class="text-neutral-400 dark:text-neutral-500"><span class="font-medium">' +
						escapeHtml(f.name) +
						'</span><span class="opacity-70"> — ' +
						escapeHtml(f.error) +
						"</span></li>";
				});
				html += "</ul></details>";
			}

			root.innerHTML = html;
		}

		var urls = (dataUrls && dataUrls.length ? dataUrls : [])
			.concat(
				root.getAttribute("data-urls")
					? root
							.getAttribute("data-urls")
							.split("|")
							.filter(Boolean)
					: [],
			)
			.filter(function (u, i, arr) {
				return u && arr.indexOf(u) === i;
			});

		if (urls.length === 0) {
			renderEmpty("还没有配置数据源", "请在 circleConfig 的 dataUrls 中填入数据源地址");
			return;
		}

		// 依次尝试，取第一个可用的数据源
		(async function () {
			for (var i = 0; i < urls.length; i++) {
				try {
					var res = await fetch(urls[i], { cache: "no-store" });
					if (!res.ok) continue;
					var data = await res.json();
					render(data);
					return;
				} catch (e) {
					// 换下一个源继续尝试
				}
			}
			renderEmpty(
				"没能读到圈子数据",
				"可到数据源仓库的 Actions 里手动运行一次 Update and Deploy",
			);
		})();
	})();
</script>
