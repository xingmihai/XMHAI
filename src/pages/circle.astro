---
import { Icon } from "astro-icon/components";
import { circleConfig, getEnabledCircleSources, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/circle.css";

// 检查页面是否启用
if (!siteConfig.pages.circle) {
	return Astro.redirect("/404/");
}

const title = circleConfig.title || "圈子";
const description =
	circleConfig.description || "朋友们最近写下的东西，由订阅源实时汇总。";

// 订阅源在构建期就能确定，这里只做数据准备，实际抓取交给浏览器完成
const sources = getEnabledCircleSources();

// 传给客户端脚本的配置
const clientConfig = {
	sources,
	proxies: circleConfig.proxies ?? [""],
	timeout: circleConfig.timeout ?? 10000,
	limitPerSource: circleConfig.limitPerSource ?? 5,
	totalLimit: circleConfig.totalLimit ?? 40,
	cacheMinutes: circleConfig.cacheMinutes ?? 30,
};
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-6">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:rss-feed-rounded" />
          </div>
          <div>
            <h2>{title}</h2>
            {description && <p>{description}</p>}
          </div>
        </div>
      </div>

      <!-- 订阅源概览 -->
      {
        sources.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-5">
            <span class="text-sm text-neutral-500 dark:text-neutral-400">
              已订阅 {sources.length} 个站点
            </span>
            {sources.map((source) => (
              <a
                href={source.site}
                target="_blank"
                rel="noopener noreferrer"
                class="circle-source-chip inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs transition-colors duration-200"
              >
                {source.avatar ? (
                  <img
                    src={source.avatar}
                    alt={source.name}
                    class="circle-source-avatar"
                  />
                ) : (
                  <Icon name="material-symbols:rss-feed-rounded" class="text-xs" />
                )}
                <span>{source.name}</span>
              </a>
            ))}
          </div>
        )
      }

      <!-- 文章列表：由客户端脚本填充 -->
      <div id="circle-content">
        {
          sources.length > 0 ? (
            <div id="circle-loading" class="circle-list" aria-busy="true">
              {Array.from({ length: 5 }).map(() => (
                <div class="circle-item flex items-start gap-3 py-3.5">
                  <div class="circle-item-avatar circle-skeleton" />
                  <div class="grow pt-0.5 space-y-2">
                    <div class="circle-skeleton h-4 w-3/4 rounded" />
                    <div class="circle-skeleton h-3 w-24 rounded" />
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="flex flex-col items-center justify-center py-14 text-neutral-400 dark:text-neutral-500">
              <Icon name="material-symbols:rss-feed-rounded" class="text-4xl mb-3" />
              <div class="text-sm">还没有配置任何订阅源</div>
              <div class="text-xs mt-1.5 opacity-70">
                在友链配置里给站点填上 rss 地址，或在 circleConfig 里手动添加订阅源
              </div>
            </div>
          )
        }
      </div>

      <!-- 抓取失败的站点提示 -->
      <div id="circle-failures"></div>

      <!-- 最后更新时间 -->
      <div
        id="circle-updated"
        class="mt-5 text-xs text-neutral-400 dark:text-neutral-500 hidden"
      >
      </div>
    </div>
  </div>
</MainGridLayout>

{/* 配置数据：以 JSON 形式注入，避免与打包脚本的 import 冲突 */}
<script
  id="circle-config"
  type="application/json"
  set:html={JSON.stringify(clientConfig)}
/>

<script>
  import { parseFeed } from "../utils/rss-parser";

  interface Source {
    name: string;
    avatar?: string;
    site: string;
    rss: string;
  }
  interface Item {
    title: string;
    link: string;
    published: string;
    timestamp: number;
    sourceName: string;
    sourceAvatar?: string;
    sourceSite: string;
  }

  const CACHE_KEY = "firefly-circle-cache";

  const configEl = document.getElementById("circle-config");
  const contentEl = document.getElementById("circle-content");
  const failuresEl = document.getElementById("circle-failures");
  const updatedEl = document.getElementById("circle-updated");

  if (configEl && contentEl) {
    const config = JSON.parse(configEl.textContent || "{}");
    const sources: Source[] = config.sources || [];
    const proxies: string[] = config.proxies || [""];
    const timeout: number = config.timeout || 10000;
    const limitPerSource: number = config.limitPerSource || 5;
    const totalLimit: number = config.totalLimit || 40;
    const cacheMinutes: number = config.cacheMinutes ?? 30;

    // 把时间戳格式化成 YYYY-MM-DD
    function formatDate(ts: number): string {
      if (!ts) return "";
      const d = new Date(ts);
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    }

    // 相对时间描述，例如「3 小时前」
    function timeAgo(ts: number): string {
      const diff = Date.now() - ts;
      const min = Math.floor(diff / 60000);
      if (min < 1) return "刚刚";
      if (min < 60) return `${min} 分钟前`;
      const hour = Math.floor(min / 60);
      if (hour < 24) return `${hour} 小时前`;
      return `${Math.floor(hour / 24)} 天前`;
    }

    // 单个订阅源：依次尝试每个代理，取第一个能解析出文章的结果
    async function fetchSource(source: Source): Promise<Item[]> {
      for (const proxy of proxies) {
        const target = proxy
          ? proxy + encodeURIComponent(source.rss)
          : source.rss;
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeout);
        try {
          const res = await fetch(target, { signal: controller.signal });
          if (!res.ok) continue;
          const text = await res.text();
          const parsed = parseFeed(text);
          if (parsed.length === 0) continue;
          return parsed.slice(0, limitPerSource).map((item) => ({
            ...item,
            sourceName: source.name,
            sourceAvatar: source.avatar,
            sourceSite: source.site,
          }));
        } catch {
          // 换下一个代理
        } finally {
          clearTimeout(timer);
        }
      }
      return [];
    }

    // 渲染文章列表
    function renderItems(items: Item[]) {
      if (!contentEl) return;
      contentEl.innerHTML = "";

      if (items.length === 0) {
        const empty = document.createElement("div");
        empty.className =
          "flex flex-col items-center justify-center py-14 text-neutral-400 dark:text-neutral-500";
        const titleEl = document.createElement("div");
        titleEl.className = "text-sm";
        titleEl.textContent = "暂时没能抓到任何文章";
        const hint = document.createElement("div");
        hint.className = "text-xs mt-1.5 opacity-70";
        hint.textContent =
          "可能是对方的订阅源暂时不可用，或代理被限流，稍后刷新再试";
        empty.append(titleEl, hint);
        contentEl.append(empty);
        return;
      }

      const list = document.createElement("div");
      list.className = "circle-list";

      for (const item of items) {
        const a = document.createElement("a");
        a.href = item.link;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className =
          "circle-item group flex items-start gap-3 py-3.5 px-3 -mx-3 rounded-xl transition-all duration-200";

        // 头像
        if (item.sourceAvatar) {
          const img = document.createElement("img");
          img.src = item.sourceAvatar;
          img.alt = item.sourceName;
          img.className = "circle-item-avatar";
          a.append(img);
        } else {
          const ph = document.createElement("div");
          ph.className =
            "circle-item-avatar circle-item-avatar--placeholder flex items-center justify-center";
          ph.textContent = "✦";
          a.append(ph);
        }

        // 标题与来源
        const body = document.createElement("div");
        body.className = "grow min-w-0";

        const t = document.createElement("div");
        t.className =
          "circle-item-title group-hover:text-(--primary) transition-colors duration-200 line-clamp-2";
        t.textContent = item.title;

        const meta = document.createElement("div");
        meta.className =
          "flex items-center gap-2 mt-1 text-xs text-neutral-500 dark:text-neutral-400";
        const name = document.createElement("span");
        name.className = "truncate max-w-[14rem]";
        name.textContent = item.sourceName;
        meta.append(name);

        if (item.timestamp) {
          const dot = document.createElement("span");
          dot.setAttribute("aria-hidden", "true");
          dot.textContent = "·";
          const time = document.createElement("time");
          time.className = "shrink-0";
          time.textContent = formatDate(item.timestamp);
          meta.append(dot, time);
        }

        body.append(t, meta);
        a.append(body);

        const arrow = document.createElement("span");
        arrow.className =
          "shrink-0 text-base text-(--primary) opacity-0 group-hover:opacity-100 transition-opacity duration-200 mt-0.5";
        arrow.textContent = "↗";
        a.append(arrow);

        list.append(a);
      }

      contentEl.append(list);
    }

    // 渲染失败提示
    function renderFailures(failed: string[]) {
      if (!failuresEl) return;
      failuresEl.innerHTML = "";
      if (failed.length === 0) return;

      const details = document.createElement("details");
      details.className = "circle-failures mt-6 text-xs";

      const summary = document.createElement("summary");
      summary.className =
        "cursor-pointer text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition-colors duration-200";
      summary.textContent = `${failed.length} 个站点未能抓到内容`;
      details.append(summary);

      const ul = document.createElement("ul");
      ul.className = "mt-2 space-y-1 pl-1";
      for (const name of failed) {
        const li = document.createElement("li");
        li.className = "text-neutral-400 dark:text-neutral-500";
        li.textContent = name;
        ul.append(li);
      }
      details.append(ul);
      failuresEl.append(details);
    }

    function showUpdated(ts: number) {
      if (!updatedEl) return;
      updatedEl.textContent = `更新于 ${timeAgo(ts)}`;
      updatedEl.classList.remove("hidden");
    }

    // 读取本地缓存
    function readCache(): { items: Item[]; ts: number } | null {
      if (cacheMinutes <= 0) return null;
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        if (!data || !Array.isArray(data.items) || !data.ts) return null;
        if (Date.now() - data.ts > cacheMinutes * 60 * 1000) return null;
        return { items: data.items, ts: data.ts };
      } catch {
        return null;
      }
    }

    function writeCache(items: Item[]) {
      if (cacheMinutes <= 0) return;
      try {
        localStorage.setItem(
          CACHE_KEY,
          JSON.stringify({ items, ts: Date.now() }),
        );
      } catch {
        // 存储不可用（例如隐私模式）时忽略
      }
    }

    async function load(useCache: boolean) {
      if (sources.length === 0) return;

      const cached = useCache ? readCache() : null;
      if (cached) {
        renderItems(cached.items);
        showUpdated(cached.ts);
        return;
      }

      const results = await Promise.all(sources.map((s) => fetchSource(s)));

      const all: Item[] = [];
      const failed: string[] = [];
      results.forEach((items, i) => {
        if (items.length > 0) {
          all.push(...items);
        } else {
          failed.push(sources[i].name);
        }
      });

      // 按发布时间倒序
      all.sort((a, b) => b.timestamp - a.timestamp);
      const final = all.slice(0, totalLimit);

      renderItems(final);
      renderFailures(failed);
      if (final.length > 0) {
        writeCache(final);
        showUpdated(Date.now());
      }
    }

    // 页面切回前台且缓存已过期时自动刷新，保证长时间停留也能看到新内容
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        const cached = readCache();
        if (!cached) load(false);
      }
    });

    load(true);
  }
</script>
