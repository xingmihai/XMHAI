---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const walineCfg = commentConfig.waline;
const { imageUploader, ...walineOptions } = walineCfg ?? {};

const config = {
	...walineOptions,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(walineCfg?.visitorCount ? { pageview: true } : {}),
};

// 贴图上传配置：函数无法序列化，这里只传可序列化的参数，在下方 script 内再组装成函数
const uploader = walineCfg?.imageUploader
	? {
			url: walineCfg.imageUploader.url,
			fieldName: walineCfg.imageUploader.fieldName ?? "file",
			responsePath: walineCfg.imageUploader.responsePath ?? "link",
		}
	: null;
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config, uploader }}>
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    const requestedPath = new URLSearchParams(window.location.search).get("path");
    const effectiveConfig = { ...config, path: requestedPath || config.path };

    // 评论贴图：上传到自建图床，返回可直接插入评论的图片链接
    if (uploader) {
      effectiveConfig.imageUploader = (file) => {
        const body = new FormData();
        body.append(uploader.fieldName, file);
        return fetch(uploader.url, { method: "POST", body })
          .then((res) => {
            if (!res.ok) throw new Error("上传接口返回 " + res.status);
            return res.json();
          })
          .then((data) => {
            const link = uploader.responsePath
              .split(".")
              .reduce((obj, key) => (obj == null ? obj : obj[key]), data);
            if (typeof link !== "string" || !link) {
              throw new Error("上传接口未返回图片链接");
            }
            return link;
          });
      };
    }

    try {
      init(effectiveConfig);
    } catch (error) {
      console.error("[Waline] Failed to initialize:", error);
    }
  </script>
</div>

<style is:global>
  /* 各分类表情数量不同，切换时面板布局会跟着变，下面逐项消除 */

  .wl-tab-wrapper {
    /* 内容溢出时出现的滚动条会挤掉约 6px 宽度，网格随之重排 */
    scrollbar-gutter: stable;
    /* 内容不足时网格区按内容收缩，比顶满时矮 1px；固定高度使其恒定。
       145px 取自 Waline 自身的 max-height，其大版本若调整需同步 */
    height: 145px;
  }

  /* Waline 给选中态加了 0 1px 1px 边框，激活的 tab 比未激活宽 2px、高 1px，
     切换时相邻 tab 会左右挪；给未选中的补等宽透明边框统一占位 */
  .wl-tabs .wl-tab:not(.active) {
    border: solid transparent;
    border-width: 0 1px 1px;
  }
</style>
